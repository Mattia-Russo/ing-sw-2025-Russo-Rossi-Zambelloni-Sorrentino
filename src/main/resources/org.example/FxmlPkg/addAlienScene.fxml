<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="borderPane" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.UIPkg.GUIPkg.AddAlienSceneController">
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- Layout orizzontale: Shipboard a sinistra, Flightboard a destra -->
            <HBox alignment="CENTER" spacing="40.0">
                <!-- Container per shipboard a sinistra -->
                <VBox alignment="CENTER" spacing="10.0">
                    <Label text="Shipboard" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Pane fx:id="shipboardContainer" prefHeight="300.0" prefWidth="400.0" 
                          minHeight="300.0" minWidth="400.0" maxHeight="300.0" maxWidth="400.0">
                        <ImageView fx:id="shipboardImageView" fitHeight="300.0" fitWidth="400.0" 
                                   pickOnBounds="true" preserveRatio="true"
                        />
                    </Pane>
                </VBox>

                <!-- Container per flightboard a destra -->
                <VBox alignment="CENTER" spacing="10.0">
                    <Label text="Flightboard" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Pane fx:id="flightboardContainer" prefHeight="300.0" prefWidth="400.0">
                        <ImageView fx:id="flightboardImageView" fitHeight="300.0" fitWidth="400.0" 
                                   pickOnBounds="true" preserveRatio="true"
                        />
                    </Pane>
                </VBox>
            </HBox>

            <!-- Sezione per visualizzare le shipboard degli altri giocatori -->
            <VBox spacing="10.0" style="-fx-padding: 10;">
                <!-- Riga con la scritta e i pulsanti degli altri giocatori -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="View Other Players' Shipboards:" textFill="WHITE" style="-fx-font-weight: bold;"/>
                    <Button fx:id="showPlayer1ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer1Shipboard"
                            text="Show Player1's Shipboard" visible="false"
                            style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="showPlayer2ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer2Shipboard"
                            text="Show Player2's Shipboard" visible="false"
                            style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="showPlayer3ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer3Shipboard"
                            text="Show Player3's Shipboard" visible="false"
                            style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Riga separata per il pulsante personale -->
                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="showOwnShipboardButton" mnemonicParsing="false" onAction="#onShowOwnShipboard"
                            prefWidth="180.0" text="Show My Shipboard"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Messaggio di validazione -->
            <Label fx:id="validationMessage" text="Validation Message" textFill="RED" visible="false"/>
        </VBox>
    </center>

    <left>
        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2a2a2a; -fx-padding: 20;">
            <!-- Status Message -->
            <Label fx:id="statusMessage" text="Add aliens to your shipboard" textFill="WHITE"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;" textAlignment="CENTER" wrapText="true"/>

            <Separator prefWidth="150.0" style="-fx-background-color: #555555;"/>

            <!-- Starting Position Controls -->
            <VBox spacing="10.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 10;">
                <Label text="Starting Position" textFill="WHITE" style="-fx-font-weight: bold;"/>
                <HBox spacing="10.0" alignment="CENTER">
                    <Label text="Position:" textFill="WHITE"/>
                    <TextField fx:id="startingPositionField" prefWidth="50.0"/>
                </HBox>
                <Button fx:id="selectPositionButton" mnemonicParsing="false" onAction="#onSelectPositionClick"
                        text="Select Position" prefWidth="120.0"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Alien Type Selection -->
            <VBox spacing="10.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 10;">
                <Label text="Alien Type" textFill="WHITE" style="-fx-font-weight: bold;"/>
                <RadioButton fx:id="violetAlienRadio" text="Violet Alien" textFill="WHITE"/>
                <RadioButton fx:id="brownAlienRadio" text="Brown Alien" textFill="WHITE"/>
            </VBox>

            <!-- Action Buttons -->
            <VBox spacing="10.0">
                <Button fx:id="addAlienButton" mnemonicParsing="false" onAction="#onAddAlienClick"
                        text="Add Alien" prefWidth="150.0"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="endAddAlienButton" mnemonicParsing="false" onAction="#onEndAddAlienClick"
                        text="End Add Alien Phase" prefWidth="150.0"
                        style="-fx-background-color: #FF5722; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>
</BorderPane>