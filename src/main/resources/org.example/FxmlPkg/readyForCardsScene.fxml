<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="borderPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.UIPkg.GUIPkg.ReadyForCardsSceneController">
    <top>
        <VBox alignment="CENTER" prefHeight="450.0" prefWidth="1200.0" spacing="10.0" BorderPane.alignment="CENTER">
            <Label fx:id="statusMessage" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"
                   text="Waiting for cards phase..."/>
            <Pane prefHeight="400.0" prefWidth="600.0" style="-fx-border-color: white; -fx-border-width: 2;">
                <ImageView fx:id="flightboardImageView" fitHeight="400.0" fitWidth="600.0"
                           pickOnBounds="true" preserveRatio="true"/>
            </Pane>
        </VBox>
    </top>
    <bottom>
        <HBox alignment="CENTER" prefHeight="350.0" prefWidth="1200.0" spacing="20.0" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="10.0">
                <Button fx:id="showPlayer1ShipboardButton" onAction="#onShowPlayer1Shipboard" prefWidth="200.0"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Show Player 1" visible="false"/>
                <Button fx:id="showPlayer2ShipboardButton" onAction="#onShowPlayer2Shipboard" prefWidth="200.0"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Show Player 2" visible="false"/>
                <Button fx:id="showPlayer3ShipboardButton" onAction="#onShowPlayer3Shipboard" prefWidth="200.0"
                        style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Show Player 3" visible="false"/>
                <Button fx:id="showOwnShipboardButton" onAction="#onShowOwnShipboard" prefWidth="200.0"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Show My Shipboard" visible="false"/>
            </VBox>
            <Pane fx:id="shipboardContainer" prefHeight="300.0" prefWidth="400.0"
                  style="-fx-border-color: white; -fx-border-width: 2;">
                <ImageView fx:id="shipboardImageView" fitHeight="300.0" fitWidth="400.0"
                           pickOnBounds="true" preserveRatio="true"/>
            </Pane>
        </HBox>
    </bottom>
</BorderPane>