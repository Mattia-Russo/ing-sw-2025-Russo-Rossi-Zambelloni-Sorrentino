<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="borderPane" prefHeight="563.0" prefWidth="1049.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.UIPkg.GUIPkg.BuildShipSceneController">
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <!-- Componente corrente in alto a sinistra della navicella -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox spacing="10.0">
                    <Label fx:id="currentComponentLabel" text="Current Component:" textFill="WHITE" />
                    <ImageView fx:id="currentComponentImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                </VBox>
                <!-- Container per navicella + componenti sovrapposti -->
                <Pane fx:id="shipboardContainer" maxHeight="300.0" maxWidth="400.0" minHeight="300.0" minWidth="400.0" prefHeight="300.0" prefWidth="400.0">                    <ImageView fx:id="shipboardImageView" fitHeight="300.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" />
                </Pane>

                <!-- Pannello per componenti scoperti -->
                <VBox fx:id="discoveredComponentsPanel" spacing="10.0" style="-fx-padding: 10; -fx-border-color: #555; -fx-border-width: 1;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Discovered Components:" textFill="WHITE" />
                    <HBox fx:id="discoveredComponentsContainer" alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 5;" />
                </VBox>
            </HBox>

            <VBox spacing="10.0" style="-fx-padding: 10;">
                <!-- Riga con la scritta e i pulsanti degli altri giocatori -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label style="-fx-font-weight: bold;" text="View Other Players' Shipboards:" textFill="WHITE" />
                    <Button fx:id="showPlayer1ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer1Shipboard" style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;" text="Show Player1's Shipboard" visible="false" />
                    <Button fx:id="showPlayer2ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer2Shipboard" style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;" text="Show Player2's Shipboard" visible="false" />
                    <Button fx:id="showPlayer3ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer3Shipboard" style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;" text="Show Player3's Shipboard" visible="false" />
                </HBox>

                <!-- Messaggio del timer -->
                <Label fx:id="timerMessage" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="" textFill="#FFD700" visible="false" />

                <!-- Riga separata per il pulsante personale -->
                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="showOwnShipboardButton" mnemonicParsing="false" onAction="#onShowOwnShipboard" prefWidth="180.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Show My Shipboard" />
                </HBox>
            </VBox>



            <!-- Messaggio di validazione -->
            <Label fx:id="validationMessage" text="Validation Message" textFill="RED" visible="false" />

            <!-- Deck Cards Display -->
            <HBox fx:id="deckCardsContainer" alignment="CENTER" spacing="15.0" style="-fx-background-color: #333; -fx-padding: 20; -fx-border-color: #666; -fx-border-width: 2;" visible="false">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Deck Cards:" textFill="WHITE" />
            </HBox>
        </VBox>
    </center>

    <left>
        <VBox alignment="CENTER" prefHeight="559.0" prefWidth="274.0" spacing="15.0" style="-fx-background-color: #2a2a2a; -fx-padding: 20;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Ship Building Controls" textFill="WHITE" />
         <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
      
                  <!-- Pick Component Button -->
                  <Button fx:id="pickComponentButton" mnemonicParsing="false" onAction="#onPickComponentClick" prefHeight="25.0" prefWidth="132.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Pick Component" />
      
                  <!-- Book Component Button -->
                  <Button fx:id="bookComponentButton" mnemonicParsing="false" onAction="#onBookComponentClick" prefHeight="25.0" prefWidth="132.0" style="-fx-background-color: #21f3a3; -fx-text-fill: white; -fx-font-weight: bold;" text="Book Component" />
            </children>
         </HBox>

            <!-- Pick Discovered Component Button -->
            <VBox spacing="5.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 5;">
                <Label contentDisplay="CENTER" prefHeight="17.0" prefWidth="218.0" style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Pick Discovered" textFill="WHITE" />
                <HBox alignment="CENTER" spacing="5.0">
                    <TextField fx:id="discoveredIndexField" alignment="TOP_CENTER" prefHeight="25.0" prefWidth="51.0" promptText="Index" />
                    <Button fx:id="pickDiscoveredButton" mnemonicParsing="false" onAction="#onPickDiscoveredClick" prefWidth="80.0" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Pick" />
                </HBox>
            </VBox>

            <!-- Pick Booked Component Button -->
            <VBox spacing="5.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 5;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Pick Booked" textFill="WHITE" />
                <HBox alignment="CENTER" spacing="5.0">
                    <TextField fx:id="bookedIndexField" prefWidth="40.0" promptText="0-1" />
                    <Button fx:id="pickBookedButton" mnemonicParsing="false" onAction="#onPickBookedClick" prefWidth="80.0" style="-fx-background-color: #795548; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Pick" />
                </HBox>
            </VBox>
         <HBox prefHeight="0.0" prefWidth="222.0">
            <children>
      
                        <!-- Rotate Left Button -->
                  <Button fx:id="rotateLeftButton" mnemonicParsing="false" onAction="#onRotateLeftClick" prefHeight="25.0" prefWidth="140.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Rotate Left" />
      
                  <!-- Rotate Right Button -->
                  <Button fx:id="rotateRightButton" mnemonicParsing="false" onAction="#onRotateRightClick" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Rotate Right" />
            </children>
         </HBox>

                  <!-- Discard Component Button -->
            <Button fx:id="discardComponentButton" mnemonicParsing="false" onAction="#onDiscardComponentClick" prefWidth="150.0" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="Discard Component" />

            <!-- Placement Controls -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 10;">
                <Label prefHeight="17.0" prefWidth="109.0" style="-fx-font-weight: bold;" text="Place Component" textAlignment="CENTER" textFill="WHITE" />
            <HBox prefHeight="5.0" prefWidth="200.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="17.0" prefWidth="23.0" text="X:" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="xPositionField" alignment="CENTER" prefHeight="25.0" prefWidth="69.0" promptText="4-10" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="Y:" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="yPositionField" alignment="CENTER" prefHeight="25.0" prefWidth="70.0" promptText="5-9" />
                     </children>
                  </HBox>
               </children>
            </HBox>

                <Button fx:id="placeComponentButton" mnemonicParsing="false" onAction="#onPlaceComponentClick" prefWidth="120.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" text="Place Component" />
            </VBox>
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <children>
      
                  <!-- Turn Timer Button -->
                  <Button fx:id="turnTimerButton" mnemonicParsing="false" onAction="#onTurnTimerClick" prefHeight="25.0" prefWidth="98.0" style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-font-weight: bold;" text="Turn Timer" />
      
                  <Button fx:id="opShip" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#onOpShipClick" prefHeight="25.0" prefWidth="103.0" style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-font-weight: bold;" text="Op Ship" textAlignment="RIGHT" />
            </children>
            <cursor>
               <Cursor fx:constant="DEFAULT" />
            </cursor>
         </HBox>

            <!-- Show Deck Button -->
            <VBox spacing="5.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 5;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Show Deck" textFill="WHITE" />
                <HBox alignment="CENTER" spacing="5.0">
                    <TextField fx:id="deckIndexField" prefHeight="25.0" prefWidth="36.0" promptText="0-2" />
                    <Button fx:id="showDeckButton" mnemonicParsing="false" onAction="#onShowDeckClick" prefWidth="80.0" style="-fx-background-color: #673AB7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" text="Show" />
      
                        <!-- End Show Deck Button -->
                  <Button fx:id="endShowDeckButton" mnemonicParsing="false" onAction="#onEndShowDeckClick" prefHeight="25.0" prefWidth="69.0" style="-fx-background-color: #8BC34A; -fx-text-fill: white; -fx-font-weight: bold;" text="End Show" visible="false" />
                </HBox>
            </VBox>
   
                  <!-- End Build Ship Button -->
            <Button fx:id="endBuildShipButton" contentDisplay="TOP" mnemonicParsing="false" onAction="#onEndBuildShipClick" prefWidth="150.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;" text="End Build Ship" />
        </VBox>
    </left>
</BorderPane>