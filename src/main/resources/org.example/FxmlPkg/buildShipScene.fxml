<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.Pane?>
<BorderPane fx:id="borderPane" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.UIPkg.GUIPkg.BuildShipSceneController">
    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <!-- Componente corrente in alto a sinistra della navicella -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox spacing="10.0">
                    <Label fx:id="currentComponentLabel" text="Current Component:" textFill="WHITE"/>
                    <ImageView fx:id="currentComponentImageView" fitHeight="100.0" fitWidth="100.0"
                               pickOnBounds="true" preserveRatio="true"/>
                </VBox>
                <!-- Container per navicella + componenti sovrapposti -->
                <Pane fx:id="shipboardContainer" prefHeight="300.0" prefWidth="400.0" minHeight="300.0" minWidth="400.0" maxHeight="300.0" maxWidth="400.0">                    <ImageView fx:id="shipboardImageView" fitHeight="300.0" fitWidth="400.0" pickOnBounds="true"
                               preserveRatio="true"/>
                </Pane>

                <!-- Pannello per componenti scoperti -->
                <VBox fx:id="discoveredComponentsPanel" spacing="10.0" style="-fx-padding: 10; -fx-border-color: #555; -fx-border-width: 1;">
                    <Label text="Discovered Components:" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <HBox fx:id="discoveredComponentsContainer" spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 5;"/>
                </VBox>
            </HBox>

            <VBox spacing="10.0" style="-fx-padding: 10;">
                <!-- Riga con la scritta e i pulsanti degli altri giocatori -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="View Other Players' Shipboards:" textFill="WHITE" style="-fx-font-weight: bold;"/>
                    <Button fx:id="showPlayer1ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer1Shipboard"
                            text="Show Player1's Shipboard" visible="false"
                            style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="showPlayer2ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer2Shipboard"
                            text="Show Player2's Shipboard" visible="false"
                            style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="showPlayer3ShipboardButton" mnemonicParsing="false" onAction="#onShowPlayer3Shipboard"
                            text="Show Player3's Shipboard" visible="false"
                            style="-fx-background-color: #b0ae27; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Messaggio del timer -->
                <Label fx:id="timerMessage" text="" textFill="#FFD700" visible="false"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

                <!-- Riga separata per il pulsante personale -->
                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="showOwnShipboardButton" mnemonicParsing="false" onAction="#onShowOwnShipboard"
                            prefWidth="180.0" text="Show My Shipboard"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>



            <!-- Messaggio di validazione -->
            <Label fx:id="validationMessage" text="Validation Message" textFill="RED" visible="false"/>

            <!-- Deck Cards Display -->
            <HBox fx:id="deckCardsContainer" spacing="15.0" alignment="CENTER" visible="false"
                  style="-fx-background-color: #333; -fx-padding: 20; -fx-border-color: #666; -fx-border-width: 2;">
                <Label text="Deck Cards:" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
        </VBox>
    </center>

    <left>
        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2a2a2a; -fx-padding: 20;">
            <Label text="Ship Building Controls" textFill="WHITE" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <!-- Pick Component Button -->
            <Button fx:id="pickComponentButton" mnemonicParsing="false" onAction="#onPickComponentClick"
                    prefWidth="150.0" text="Pick Component"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- Pick Discovered Component Button -->
            <VBox spacing="5.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 5;">
                <Label text="Pick Discovered" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <HBox spacing="5.0" alignment="CENTER">
                    <TextField fx:id="discoveredIndexField" prefWidth="40.0" promptText="Index"/>
                    <Button fx:id="pickDiscoveredButton" mnemonicParsing="false" onAction="#onPickDiscoveredClick"
                            prefWidth="80.0" text="Pick"
                            style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <!-- Book Component Button -->
            <Button fx:id="bookComponentButton" mnemonicParsing="false" onAction="#onBookComponentClick"
                    prefWidth="150.0" text="Book Component"
                    style="-fx-background-color: #21f3a3; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- Pick Booked Component Button -->
            <VBox spacing="5.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 5;">
                <Label text="Pick Booked" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <HBox spacing="5.0" alignment="CENTER">
                    <TextField fx:id="bookedIndexField" prefWidth="40.0" promptText="0/1"/>
                    <Button fx:id="pickBookedButton" mnemonicParsing="false" onAction="#onPickBookedClick"
                            prefWidth="80.0" text="Pick"
                            style="-fx-background-color: #795548; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <!-- Discard Component Button -->
            <Button fx:id="discardComponentButton" mnemonicParsing="false" onAction="#onDiscardComponentClick"
                    prefWidth="150.0" text="Discard Component"
                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- Rotate Left Button -->
            <Button fx:id="rotateLeftButton" mnemonicParsing="false" onAction="#onRotateLeftClick"
                    prefWidth="150.0" text="Rotate Left"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- Rotate Right Button -->
            <Button fx:id="rotateRightButton" mnemonicParsing="false" onAction="#onRotateRightClick"
                    prefWidth="150.0" text="Rotate Right"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- End Build Ship Button -->
            <Button fx:id="endBuildShipButton" mnemonicParsing="false" onAction="#onEndBuildShipClick"
                    prefWidth="150.0" text="End Build Ship"
                    style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- Placement Controls -->
            <VBox spacing="10.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 10;">
                <Label text="Place Component" textFill="WHITE" style="-fx-font-weight: bold;"/>

                <HBox spacing="10.0" alignment="CENTER">
                    <Label fx:id="xLabel" text="X:" textFill="WHITE"/>
                    <TextField fx:id="xPositionField" prefWidth="50.0" promptText="4-10"/>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER">
                    <Label fx:id="yLabel" text="Y:" textFill="WHITE"/>
                    <TextField fx:id="yPositionField" prefWidth="50.0" promptText="5-9"/>
                </HBox>

                <Button fx:id="placeComponentButton" mnemonicParsing="false" onAction="#onPlaceComponentClick"
                        prefWidth="120.0" text="Place Component"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Turn Timer Button -->
            <Button fx:id="turnTimerButton" mnemonicParsing="false" onAction="#onTurnTimerClick"
                    prefWidth="150.0" text="Turn Timer"
                    style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- Show Deck Button -->
            <VBox spacing="5.0" style="-fx-border-color: #555; -fx-border-width: 1; -fx-padding: 5;">
                <Label text="Show Deck" textFill="WHITE" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <HBox spacing="5.0" alignment="CENTER">
                    <TextField fx:id="deckIndexField" prefWidth="40.0" promptText="0-2"/>
                    <Button fx:id="showDeckButton" mnemonicParsing="false" onAction="#onShowDeckClick"
                            prefWidth="80.0" text="Show"
                            style="-fx-background-color: #673AB7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <!-- End Show Deck Button -->
            <Button fx:id="endShowDeckButton" mnemonicParsing="false" onAction="#onEndShowDeckClick"
                    prefWidth="150.0" text="End Show Deck" visible="false"
                    style="-fx-background-color: #8BC34A; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>
</BorderPane>