<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="borderPane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.UIPkg.GUIPkg.WaitingRoomSceneController">
    <top>
        <!-- Container per le impostazioni della lobby -->
        <VBox fx:id="settingsContainer" alignment="CENTER" spacing="15.0" style="-fx-background-color: rgba(0,0,0,0.8); -fx-background-radius: 10; -fx-padding: 20;">
            <children>
                <Label fx:id="settingsTitle" text="Lobby Settings" />

                <HBox alignment="CENTER" spacing="40.0">
                    <children>
                        <Label fx:id="maxPlayersLabel" text="Max Players: -" />
                        <Label fx:id="shipboardLevelLabel" text="Shipboard Level: -" />
                        <Label fx:id="gameModeLabel" text="Game Mode: -" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>
        </VBox>
    </top>

    <center>
        <!-- Container principale con lista giocatori -->
        <VBox fx:id="playersContainer" alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="20.0"/>
            </padding>
            <Label fx:id="playersLabel" text="Players (0/0)"/>

            <!-- Lista dei giocatori -->
            <ListView fx:id="playersListView" maxHeight="300.0" maxWidth="400.0" prefHeight="200.0" prefWidth="300.0"/>

            <!-- Messaggio di stato -->
            <Label fx:id="statusMessage" visible="false"/>

            <!-- Pulsanti di azione -->
            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="startGameButton" onAction="#onStartGameClick" text="Start Game"
                        style="-fx-font-size: 16px; -fx-padding: 12px 25px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;"
                        visible="false"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>