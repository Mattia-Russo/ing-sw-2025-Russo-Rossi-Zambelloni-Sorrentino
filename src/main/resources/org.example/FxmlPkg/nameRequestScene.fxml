<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="borderPane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.UIPkg.GUIPkg.NameRequestSceneController">
    <center>
        <VBox fx:id="controls" alignment="CENTER" spacing="10.0">
            <Label fx:id="askName" text="Enter your name:" textFill="WHITE" visible="false"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TextField fx:id="nameBox" maxWidth="200.0" promptText="Your name..."/>
            <Button fx:id="confirmNameButton" onAction="#onConfirmNameButtonClick" text="Confirm Name" visible="false"/>
            <Label fx:id="nameInvalid" textFill="RED" visible="false" style="-fx-font-size: 14px;"/>
            <Button fx:id="createLobbyButton" onAction="#onCreateLobbyButtonClick" text="Create Lobby" visible="false"
                    style="-fx-font-size: 16px; -fx-padding: 10px 20px;"/>
            <Button fx:id="joinLobbyButton" onAction="#onJoinLobbyButtonClick" text="Join Lobby" visible="false"
                    style="-fx-font-size: 16px; -fx-padding: 10px 20px;"/>
            <Label fx:id="lobbyMessage" textFill="ORANGE" visible="false"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        </VBox>
    </center>
</BorderPane>